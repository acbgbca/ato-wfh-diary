{
	"name": "ATO Work From Home Diary",
	"image": "mcr.microsoft.com/devcontainers/go:2-1.25-bookworm",

	// 👇 Features to add to the Dev Container. More info: https://containers.dev/implementors/features.
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4": {
			"moby": false
		},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/prulloac/devcontainer-features/bun:1": {},
		"ghcr.io/devcontainers/features/node:2": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	// Install Chromium and its system library dependencies for E2E tests (Rod/CDP).
	"postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends chromium"

	// 👇 Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// 👇 Configure tool-specific properties.
	// "customizations": {},

	// 👇 Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
